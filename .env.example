# ---- Telegram ----
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BOT_USERNAME=your_bot_username
WEBAPP_URL=https://your-domain.com

# ---- Server ----
PORT=3000
NODE_ENV=production

# ---- Supabase (Project Settings -> API) ----
# الرابط الكامل مع .supabase.co ، والمفتاح السري service_role / secret (بدون مسافات أو علامات اقتباس)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin ----
ADMIN_TELEGRAM_IDS=111111111,222222222
ADMIN_PANEL_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string

# ---- AdsGram ----
# اتركهما فارغين الآن إلى حين إنشاء البلوكات من partner.adsgram.ai
# Reward: بلوك من نوع Rewarded (رقم عادي بدون بادئة) — هذا هو الإعلان الذي يربح المستخدم منه.
ADSGRAM_REWARD_BLOCK_ID=
# Interstitial: بلوك من نوع Interstitial (يبدأ بالبادئة int-) — إعلان انتقالي عادي، لا يمنح المستخدم ربحًا.
ADSGRAM_INTERSTITIAL_BLOCK_ID=
