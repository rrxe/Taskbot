NODE_ENV=production
PORT=3000

# Supabase (server-side only; never expose the service role key to Vite)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Telegram bot that owns the Easy Gram Mini App
TELEGRAM_BOT_TOKEN=123456:YOUR_EASYGRAM_BOT_TOKEN
BOT_USERNAME=your_easygram_bot
WEBAPP_URL=https://your-domain.example
TELEGRAM_WEBHOOK_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
TELEGRAM_INITDATA_MAX_AGE_SECONDS=86400

# Admin panel: https://your-domain.example/admin
ADMIN_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET

# AdsGram INT blocks
ADSGRAM_AUTO_BLOCK=int-58010
ADSGRAM_REWARD_BLOCK=int-58009
